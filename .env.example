# PostgreSQL connection string
DATABASE_URL=postgres://oakcraft:change-me@localhost:5432/oakcraft_crm

# First admin account, created by `npm run db:seed` (change the password after first login)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@oakcraft.in
ADMIN_PASSWORD=ChangeMe@123

# Set to "true" when the app is served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false

# Maximum upload size for marketplace files, in MB
MAX_UPLOAD_MB=30
